# Copia questo file in .env e compila i valori. .env non si committa.
# Ogni variabile nuova va aggiunta qui, senza valore.

# Modello linguistico (agents/src/napoles_agents/llm/). LLM_PROVIDER: anthropic | finto
# (vuoto: anthropic se c'è la chiave). LLM_MODEL predefinito: claude-opus-5-5. Senza chiave: testi a regole.
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=

# Google Maps Platform. Due chiavi separate (docs/DEPLOY.md):
# MAPS_API_KEY: lato server, solo Routes API (tempi con traffico reale), mai nel browser
MAPS_API_KEY=
# MAPS_JS_API_KEY: lato browser, solo Maps JavaScript API, limitata ai domini della web app
MAPS_JS_API_KEY=
# Limiti per restare nella quota gratuita di Routes API (predefiniti 600 e 150)
TRAFFICO_TTL_S=
TRAFFICO_MAX_CHIAMATE_GIORNO=

# Web app: indirizzo dell'API degli agenti usato dal gateway backend/ (predefinito http://127.0.0.1:8001)
AGENTS_URL=

# football-data.org: partite in casa del Napoli al Maradona (chiave gratuita, header X-Auth-Token)
FOOTBALL_DATA_API_KEY=
# Per quanti secondi tenere in memoria il calendario (predefinito 21600, cioè 6 ore)
PARTITE_TTL_S=

# Contesto reale, servizi pubblici senza chiave: secondi in memoria per INGV (predefinito 120) e meteo (600)
INGV_TTL_S=
METEO_TTL_S=
# Livello di allerta vulcanica ufficiale (Protezione Civile): secondi in memoria (predefinito 3600)
VULCANI_TTL_S=
